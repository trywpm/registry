{
  "plugins": ["typescript", "import"],
  "categories": {
    "suspicious": "warn",
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/.git/**",
    "**/dist/**",
    "**/build/**",
    "**/.wrangler/**",
    "www/src/public/**",
    "**/node_modules/**",
    "www/src/components/ui/**"
  ],
  "overrides": [
    {
      "files": ["**/*.astro"],
      "rules": {
        "no-unused-expressions": "off"
      }
    }
  ],
  "rules": {
    "no-var": "error",
    "no-empty": "warn",
    "no-debugger": "error",
    "prefer-const": "error",
    "curly": ["error", "all"],
    "eqeqeq": ["error", "always"],
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "**/*.scss"]
      }
    ]
  }
}
