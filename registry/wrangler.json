{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wpm-registry",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "assets",
    "directory": "src/public"
  },
  "dev": {
    "port": 3001,
    "inspector_port": 9230
  },
  "vars": {
    "SIG_KEY_ID": "bfee8dd8-0f5a-472e-b309-7bd0d2f38622",
    "SIG_KEY_SPKI_FINGERPRINT": "sha256:9/oofuyiEytGPeRG82jpV3ki7DVwG4AheqeqoFmTz5k"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "r2_buckets": [
    {
      "binding": "readme",
      "bucket_name": "wpm-readme-storage"
    },
    {
      "binding": "manifest",
      "bucket_name": "wpm-manifest-storage"
    },
    {
      "binding": "tarball",
      "bucket_name": "wpm-tarball-storage"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "cache",
      "id": "c65865f6bdc24667986699702ee727d1"
    }
  ],
  "d1_databases": [
    {
      "binding": "registry_search",
      "database_name": "registry_search_db",
      "database_id": "488343ab-bac0-43a5-b700-5ae45f39df45",
      "migrations_dir": "../packages/d1/src/search/migrations"
    }
  ],
  "hyperdrive": [
    {
      "id": "6d4fe5aebbe649ceb316d687436c7653",
      "binding": "pg",
      "localConnectionString": "postgresql://wpm:wpm@localhost:5432/wpm"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "publish",
        "class_name": "Publish"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Publish"]
    }
  ],
  "routes": [
    {
      "pattern": "registry.wpm.so",
      "custom_domain": true
    }
  ],
  "rules": [{ "type": "CompiledWasm", "globs": ["gfm-wasm/wasm"], "fallthrough": true }]
}
