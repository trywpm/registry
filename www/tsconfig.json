{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsxImportSource": "react",
    "types": ["astro/client"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.astro", ".astro/types.d.ts"],
  "exclude": ["node_modules", "dist"],
  "references": []
}
