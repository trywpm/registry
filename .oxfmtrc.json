{
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "insertFinalNewline": true,
  "ignorePatterns": [
    "**/.git/**",
    "**/dist/**",
    "**/build/**",
    "**/.wrangler/**",
    "www/src/public/**",
    "**/node_modules/**",
    "www/src/components/ui/**"
  ],
  "overrides": [
    {
      "files": ["*.md"],
      "options": {
        "printWidth": 80
      }
    },
    {
      "files": ["*.json", "*.jsonc", "package.json"],
      "options": {
        "trailingComma": "none"
      }
    }
  ]
}
