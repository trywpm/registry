{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src/**/*", ".astro/types.d.ts", "worker-types.d.ts"],
  "references": [
    { "path": "../packages/d1" },
    { "path": "../packages/util" },
    { "path": "../packages/datetime" },
    { "path": "../packages/manifest" }
  ]
}
